        "options": {
          "temperature": 0.2
        }
      },
      "id": "a1000000-0000-4000-8000-000000000032",
      "name": "Gemini Flash",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1280,
        440
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "7eWnbnBsMvbxk6NZ",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Parse the LLM's URL selection and filter the ORIGINAL normalized items.\n// The LLM never rewrites item data - a hallucinated URL fails loudly here (spec 03).\nconst first = $input.first().json;\nconst raw = String(first.text ?? first.output ?? '').trim();\nconst cleaned = raw.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\n\nlet urls;\ntry {\n  urls = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('LLM returned non-JSON output: ' + raw.slice(0, 200));\n}\nif (!Array.isArray(urls) || !urls.every((u) => typeof u === 'string')) {\n  throw new Error('LLM output is not a JSON array of URL strings: ' + cleaned.slice(0, 200));\n}\n\nconst byUrl = new Map($('Normalize').all().map((i) => [i.json.url, i.json]));\nconst seen = new Set();\nconst selected = [];\nfor (const u of urls) {\n  if (seen.has(u)) continue;\n  seen.add(u);\n  const item = byUrl.get(u);\n  if (!item) throw new Error('LLM returned a URL absent from the input list: ' + u);\n  selected.push({ json: item });\n  if (selected.length >= 10) break;\n}\nif (selected.length === 0) throw new Error('LLM selected no valid items');\nreturn selected;"
      },
      "id": "a1000000-0000-4000-8000-000000000033",
      "name": "Filter selected",
      "type": "n8n-nodes-base.code",
