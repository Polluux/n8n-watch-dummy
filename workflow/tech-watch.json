    {
      "parameters": {
        "jsCode": "// Normalize RSS items to {title, url, source, publishedAt, excerpt}\n// Rules (spec 02): strip HTML, drop missing URL, drop older than 48h,\n// sort by publishedAt desc, cap at 60 items.\nconst cutoff = Date.now() - 48 * 3600 * 1000;\nconst strip = (s) => String(s ?? '')\n  .replace(/<[^>]*>/g, ' ')\n  .replace(/&nbsp;/g, ' ')\n  .replace(/&amp;/g, '&')\n  .replace(/&lt;/g, '<')\n  .replace(/&gt;/g, '>')\n  .replace(/&#39;|&apos;/g, \"'\")\n  .replace(/&quot;/g, '\"')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst out = [];\nfor (const { json } of $input.all()) {\n  const url = json.link;\n  if (!url) continue;\n  const ts = Date.parse(json.isoDate || json.pubDate || '');\n  if (!ts || ts < cutoff) continue;\n  out.push({\n    json: {\n      title: strip(json.title),\n      url,\n      source: json.source,\n      publishedAt: new Date(ts).toISOString(),\n      excerpt: strip(json.contentSnippet || json.content).slice(0, 300),\n    },\n  });\n}\n\nout.sort((a, b) => b.json.publishedAt.localeCompare(a.json.publishedAt));\nreturn out.slice(0, 60);"
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Normalize",
      "type": "n8n-nodes-base.code",
