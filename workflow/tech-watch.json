    {
      "parameters": {
        "promptType": "define",
        "text": "=You are curating a daily tech-watch digest for a French consulting software engineer.\nEditorial line: software engineering, AI/LLM tooling, DevOps, cloud, security.\n\nFrom the JSON list of items below, select the most relevant ones — MAXIMUM 10.\nDeduplicate: if the same story is covered by several sources, keep only the single best link.\nPrefer substantial, technical stories over marketing or minor product news.\n\nReturn ONLY a JSON array of the selected items' \"url\" values, copied exactly as they appear in the input.\nNo markdown fences, no commentary, no object wrapper — just the array.\n\nItems:\n{{ JSON.stringify($json.data) }}"
      },
      "id": "a1000000-0000-4000-8000-000000000031",
      "name": "Select links",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1280,
        220
      ]
    },
    {
